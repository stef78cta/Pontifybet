# Copiază acest fișier ca .env și completează valorile (NU comite .env)

# Obligatoriu — cheia FootyStats (din https://footystats.org/api/u/api-settings)
FOOTYSTATS_API_KEY=

# Parolă unică pentru accesul la aplicație
APP_PASSWORD=schimba-aceasta-parola

# Timeout HTTP în secunde
FOOTYSTATS_TIMEOUT=20

# Număr maxim de retry-uri
FOOTYSTATS_RETRIES=2
